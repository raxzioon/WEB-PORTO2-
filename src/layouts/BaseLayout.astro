---
import '../styles/global.css';
import { siteContent } from '../data/content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteContent.meta.title,
  description = siteContent.meta.description,
} = Astro.props;
---

<!doctype html>
<html lang="id" class="w-full max-w-full overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <meta name="author" content={siteContent.meta.author} />
    <meta name="theme-color" content="#F4F0E6" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteContent.meta.url} />
    <meta property="og:site_name" content="Adzka Arroya Portfolio" />
    <meta property="og:image" content="/images/adzka-profile.png" />

    <title>{title}</title>

    <!-- Google Fonts: Archivo Black (Headings), Space Grotesk (Body), JetBrains Mono (Labels/Numbers) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=JetBrains+Mono:wght@400;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon: Clean Brutalist SVG -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23B3202A'/><rect x='8' y='8' width='84' height='84' fill='%23FFD23F' stroke='%230A0A0A' stroke-width='6'/><text x='50%' y='62%' font-family='sans-serif' font-weight='900' font-size='48' fill='%230A0A0A' text-anchor='middle'>A</text></svg>"
    />

    <!-- Progressive Enhancement Motion Initializer -->
    <script is:inline>
      try {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('js-ready');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="bg-[#F4F0E6] text-[#0A0A0A] font-['Space_Grotesk'] antialiased selection:bg-[#FFD23F] selection:text-black w-full max-w-full overflow-x-hidden min-h-screen">
    <slot />

    <!-- Snappy Neo-Brutalist Scroll & Counter Controller -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          // Rapid, snappy integer counter
          const animateCounter = (el) => {
            const target = parseInt(el.getAttribute('data-counter-target') || '0', 10);
            if (isNaN(target) || target <= 0) return;

            const suffix = el.getAttribute('data-counter-suffix') || '';
            const formatId = el.getAttribute('data-counter-format') === 'id';
            const duration = 450;
            const startTime = performance.now();

            const update = (now) => {
              const elapsed = now - startTime;
              const progress = Math.min(elapsed / duration, 1);
              // Snappy Out-Cubic
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = Math.floor(eased * target);

              let formatted = current.toString();
              if (formatId && current >= 1000) {
                formatted = current.toLocaleString('id-ID');
              }

              el.textContent = formatted + suffix;

              if (progress < 1) {
                requestAnimationFrame(update);
              } else {
                let finalFormatted = target.toString();
                if (formatId && target >= 1000) {
                  finalFormatted = target.toLocaleString('id-ID');
                }
                el.textContent = finalFormatted + suffix;
              }
            };

            requestAnimationFrame(update);
          };

          // IntersectionObserver for elements
          const observerOptions = {
            root: null,
            rootMargin: '0px 0px -40px 0px',
            threshold: 0.08,
          };

          const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');

                // Trigger counters inside entry
                const counterEls = entry.target.querySelectorAll('[data-counter-target]');
                counterEls.forEach((c) => {
                  if (!c.dataset.counterStarted) {
                    c.dataset.counterStarted = 'true';
                    animateCounter(c);
                  }
                });

                if (entry.target.hasAttribute('data-counter-target') && !entry.target.dataset.counterStarted) {
                  entry.target.dataset.counterStarted = 'true';
                  animateCounter(entry.target);
                }

                observer.unobserve(entry.target);
              }
            });
          }, observerOptions);

          document.querySelectorAll('.scroll-reveal, .scroll-reveal-scale, .timeline-item').forEach((el) => {
            revealObserver.observe(el);
          });
        } catch (err) {
          console.warn('Motion init error:', err);
        }
      });
    </script>
  </body>
</html>
