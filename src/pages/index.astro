---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import ProofStrip from '../components/ProofStrip.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Experience from '../components/Experience.astro';
import TeachingAndResearch from '../components/TeachingAndResearch.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import RateCard from '../components/RateCard.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { siteContent } from '../data/content';
---

<BaseLayout
  title={siteContent.meta.title}
  description={siteContent.meta.description}
>
  <!-- Sticky Neo-Brutalist Navigation -->
  <Navbar />

  <main id="main-content">
    <!-- Hero Section with Primary Positioning & Proof -->
    <Hero />

    <!-- Single Bold Ticker Banner -->
    <Ticker />

    <!-- 4 Real Data Proof Numbers -->
    <ProofStrip />

    <!-- Deep Case Studies (Desa Denanyar & TelUGig) -->
    <CaseStudies />

    <!-- Vertical Career & Academic Timeline -->
    <Experience />

    <!-- Distinct Differentiator: Teaching & Academic ML Research -->
    <TeachingAndResearch />

    <!-- Grouped Skills Matrix (No fake % bars) -->
    <Skills />

    <!-- Industry Certifications Grid -->
    <Certifications />

    <!-- Realistic Rate Card & Services (with clear [ISI: ...] placeholders) -->
    <RateCard />

    <!-- Testimonials Module (Toggleable via config) -->
    <Testimonials />

    <!-- High-Impact Contact Terminal -->
    <Contact />
  </main>

  <!-- Minimalist Brutalist Footer -->
  <Footer />
</BaseLayout>
