---
import { siteContent } from '../data/content';
---

<header class="sticky top-0 z-50 bg-[#F4F0E6] border-b-[3px] border-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      <!-- Logo / Name -->
      <a
        href="#"
        class="group flex items-center gap-2 focus:outline-none focus:ring-4 focus:ring-[#3A5BFF]"
        aria-label="Kembali ke atas"
      >
        <span class="font-['Archivo_Black'] text-xl sm:text-2xl tracking-tight text-black group-hover:text-[#B3202A] transition-colors">
          ADZKA.ARROYA
        </span>
        <span class="hidden sm:inline-block font-['JetBrains_Mono'] text-xs font-bold uppercase px-2 py-0.5 bg-[#FFD23F] border-[2px] border-black shadow-[2px_2px_0_#000]">
          SI / TELKOM
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6" aria-label="Navigasi Utama">
        <a
          href="#studi-kasus"
          class="font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider text-black hover:text-[#B3202A] transition-colors py-1 border-b-2 border-transparent hover:border-black focus:outline-none focus:ring-2 focus:ring-[#3A5BFF]"
        >
          Proyek
        </a>
        <a
          href="#pengalaman"
          class="font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider text-black hover:text-[#B3202A] transition-colors py-1 border-b-2 border-transparent hover:border-black focus:outline-none focus:ring-2 focus:ring-[#3A5BFF]"
        >
          Pengalaman
        </a>
        <a
          href="#riset-mengajar"
          class="font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider text-black hover:text-[#B3202A] transition-colors py-1 border-b-2 border-transparent hover:border-black focus:outline-none focus:ring-2 focus:ring-[#3A5BFF]"
        >
          Mengajar & Riset
        </a>
        <a
          href="#keahlian"
          class="font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider text-black hover:text-[#B3202A] transition-colors py-1 border-b-2 border-transparent hover:border-black focus:outline-none focus:ring-2 focus:ring-[#3A5BFF]"
        >
          Keahlian
        </a>
        <a
          href="#layanan"
          class="font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider text-black hover:text-[#B3202A] transition-colors py-1 border-b-2 border-transparent hover:border-black focus:outline-none focus:ring-2 focus:ring-[#3A5BFF]"
        >
          Layanan
        </a>
      </nav>

      <!-- Desktop Contact CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={siteContent.personal.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-[#FFD23F] text-black font-['JetBrains_Mono'] text-xs md:text-sm font-bold uppercase border-[3px] border-black shadow-[4px_4px_0_#000] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_#000] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all focus:outline-none focus:ring-4 focus:ring-[#3A5BFF]"
        >
          <!-- Phone / Chat SVG Icon -->
          <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
          <span>WhatsApp Saya</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 sm:hidden">
        <a
          href={siteContent.personal.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Kirim WhatsApp"
          class="p-2 bg-[#FFD23F] border-[2px] border-black shadow-[2px_2px_0_#000] text-black"
        >
          <svg class="w-5 h-5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Buka menu navigasi"
          class="p-2 bg-white border-[3px] border-black shadow-[3px_3px_0_#000] text-black focus:outline-none focus:ring-4 focus:ring-[#3A5BFF]"
        >
          <svg id="menu-icon-open" class="w-6 h-6 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden w-6 h-6 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden sm:hidden border-t-[3px] border-black bg-[#F4F0E6] px-4 py-4 space-y-3"
  >
    <a
      href="#studi-kasus"
      class="mobile-nav-link block font-['JetBrains_Mono'] text-base font-bold uppercase tracking-wider py-2 px-3 border-[2px] border-black bg-white shadow-[3px_3px_0_#000] text-black"
    >
      → Proyek (Studi Kasus)
    </a>
    <a
      href="#pengalaman"
      class="mobile-nav-link block font-['JetBrains_Mono'] text-base font-bold uppercase tracking-wider py-2 px-3 border-[2px] border-black bg-white shadow-[3px_3px_0_#000] text-black"
    >
      → Pengalaman Kerja & Lab
    </a>
    <a
      href="#riset-mengajar"
      class="mobile-nav-link block font-['JetBrains_Mono'] text-base font-bold uppercase tracking-wider py-2 px-3 border-[2px] border-black bg-white shadow-[3px_3px_0_#000] text-black"
    >
      → Mengajar & Riset
    </a>
    <a
      href="#keahlian"
      class="mobile-nav-link block font-['JetBrains_Mono'] text-base font-bold uppercase tracking-wider py-2 px-3 border-[2px] border-black bg-white shadow-[3px_3px_0_#000] text-black"
    >
      → Keahlian & Tech Stack
    </a>
    <a
      href="#layanan"
      class="mobile-nav-link block font-['JetBrains_Mono'] text-base font-bold uppercase tracking-wider py-2 px-3 border-[2px] border-black bg-white shadow-[3px_3px_0_#000] text-black"
    >
      → Layanan & Rate Card
    </a>
    <a
      href={siteContent.personal.whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="block text-center font-['JetBrains_Mono'] text-base font-bold uppercase tracking-wider py-2.5 px-4 border-[3px] border-black bg-[#FFD23F] shadow-[4px_4px_0_#000] text-black mt-2"
    >
      Hubungi via WhatsApp (+62 819-0660-2421)
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const links = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      btn?.setAttribute('aria-expanded', 'true');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  }

  btn?.addEventListener('click', toggleMenu);

  links.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
