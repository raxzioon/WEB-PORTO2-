---
import { siteContent } from '../data/content';
---

<section class="border-b-[3px] border-black bg-[#F4F0E6] py-8 sm:py-14 md:py-18 overflow-hidden w-full max-w-full">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center min-w-0">
      
      <!-- Left Column: Copy & Actions (7 cols) -->
      <div class="lg:col-span-7 space-y-5 sm:space-y-6 min-w-0">
        
        <!-- Availability / Status Tag -->
        <div class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1 bg-white border-[2px] border-black shadow-[2px_2px_0_#000] sm:shadow-[3px_3px_0_#000]">
          <span class="w-2 h-2 bg-[#B3202A] inline-block"></span>
          <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs font-bold uppercase tracking-wider text-black">
            {siteContent.personal.statusBadge}
          </span>
        </div>

        <!-- Gigantic Brutalist Headline: Clean wrapping across 375, 768, 1440 -->
        <h1 class="font-['Archivo_Black'] text-2xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-[1.12] tracking-tight text-black break-words min-w-0">
          Website desa untuk<br class="sm:hidden" />
          <span class="bg-[#FFD23F] px-1.5 sm:px-2 py-0.5 border-[3px] border-black inline-block my-1 shadow-[2px_2px_0_#000] sm:shadow-[4px_4px_0_#000]">4.500 warga.</span><br class="sm:hidden" />
          Dibangun berdua dari nol.
        </h1>

        <!-- One Sentence Subhead (Positioning Statement) -->
        <p class="font-['Space_Grotesk'] text-sm sm:text-lg md:text-xl font-medium text-[#1A1A1A] max-w-2xl leading-relaxed break-words min-w-0">
          {siteContent.personal.subheadline}
        </p>

        <!-- Identity Subtext: Real Facts -->
        <div class="flex flex-wrap items-center gap-x-2 sm:gap-x-3 gap-y-1 pt-1 font-['JetBrains_Mono'] text-[11px] sm:text-sm text-neutral-800 break-words min-w-0">
          <span class="font-bold text-black">{siteContent.personal.fullName}</span>
          <span class="text-neutral-400 font-black">/</span>
          <span>{siteContent.personal.major}</span>
          <span class="text-neutral-400 font-black">/</span>
          <span class="text-[#B3202A] font-bold">{siteContent.personal.campus}</span>
        </div>

        <!-- 2 Prominent Call to Actions -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a
            href="#studi-kasus"
            class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 bg-[#B3202A] text-white font-['JetBrains_Mono'] text-xs sm:text-sm md:text-base font-bold uppercase border-[3px] border-black shadow-[3px_3px_0_#000] sm:shadow-[4px_4px_0_#000] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_#000] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none transition-all focus:outline-none focus:ring-4 focus:ring-[#3A5BFF]"
          >
            <span>Lihat Bukti Proyek</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <a
            href={siteContent.personal.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 bg-white text-black font-['JetBrains_Mono'] text-xs sm:text-sm md:text-base font-bold uppercase border-[3px] border-black shadow-[3px_3px_0_#000] sm:shadow-[4px_4px_0_#000] hover:bg-[#FFD23F] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_#000] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none transition-all focus:outline-none focus:ring-4 focus:ring-[#3A5BFF]"
          >
            <span>Hubungi via WhatsApp</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Quick proof bullets -->
        <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-['JetBrains_Mono'] text-neutral-800">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-black shrink-0"></span>
            <span>Laravel • Livewire • Docker • MySQL</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-black shrink-0"></span>
            <span>Pengajar Roblox, Asisten Lab & Riset ML</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Framed Photo + Sticker (5 cols) -->
      <div class="lg:col-span-5 relative mt-6 lg:mt-0 min-w-0">
        
        <!-- Rotating Sticker Badge: Juara 1 BizCREATE 2026 (Max 2-3 rotated elements, safe mobile bounds) -->
        <div class="absolute -top-3 left-2 sm:-left-4 z-20 transform -rotate-2 bg-[#FFD23F] border-[3px] border-black shadow-[3px_3px_0_#000] sm:shadow-[4px_4px_0_#000] px-3 py-1.5 max-w-[220px]">
          <div class="font-['JetBrains_Mono'] text-[10px] sm:text-[11px] font-black uppercase tracking-wider text-black flex items-center gap-1.5">
            <span class="w-2 h-2 bg-[#B3202A] inline-block"></span>
            JUARA 1 BIZCREATE 2026
          </div>
          <p class="font-['Space_Grotesk'] text-[10px] sm:text-xs font-bold text-black mt-0.5 leading-tight">
            TelUGig • Platform Freelance Kampus x UMKM
          </p>
        </div>

        <!-- Frame Card with High-Contrast Photo -->
        <div class="bg-white border-[3px] border-black shadow-[5px_5px_0_#000] sm:shadow-[8px_8px_0_#000] p-3 sm:p-4 relative">
          
          <!-- Top Window Controls (Brutalist Decorative Bar) -->
          <div class="flex items-center justify-between border-b-[2px] border-black pb-2 mb-2.5">
            <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs font-bold uppercase tracking-wider">
              PROFILE_BUILDER.RAW
            </span>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 border-[2px] border-black bg-white inline-block"></span>
              <span class="w-2.5 h-2.5 border-[2px] border-black bg-[#FFD23F] inline-block"></span>
              <span class="w-2.5 h-2.5 border-[2px] border-black bg-[#B3202A] inline-block"></span>
            </div>
          </div>

          <!-- Photo Container -->
          <div class="relative bg-[#E8E2D5] border-[2px] border-black overflow-hidden aspect-[4/5] flex items-end justify-center">
            <!-- Grid pattern background inside photo box -->
            <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#000_1px,transparent_1px)] [background-size:12px_12px]"></div>
            
            <img
              src="/images/adzka-profile.png"
              alt="Foto resmi Muhammad Adzka Arroya, builder web dan pengajar IT"
              width="450"
              height="560"
              class="relative z-10 w-full h-full object-contain object-bottom grayscale contrast-125 filter"
              loading="eager"
            />

            <!-- Bottom Floating Tag -->
            <div class="absolute bottom-2 left-2 right-2 z-20 bg-white/95 border-[2px] border-black p-2 shadow-[2px_2px_0_#000]">
              <div class="font-['JetBrains_Mono'] text-[10px] sm:text-[11px] font-bold text-black uppercase flex items-center justify-between">
                <span>Adzka Arroya</span>
                <span class="text-[#3A5BFF]">SI Telkom 2025</span>
              </div>
            </div>
          </div>

          <!-- Card Bottom Meta -->
          <div class="mt-2.5 pt-2 border-t-[2px] border-black flex items-center justify-between font-['JetBrains_Mono'] text-[10px] sm:text-xs text-neutral-700">
            <span>Kabupaten Bekasi / Bandung</span>
            <span class="font-bold text-black">Hafidz 30 Juz (2019)</span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
