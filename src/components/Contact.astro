---
import { siteContent } from '../data/content';
const { personal } = siteContent;
---

<section id="kontak" class="border-b-[3px] border-black bg-[#F4F0E6] py-12 sm:py-18 md:py-24 overflow-hidden w-full max-w-full">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-black text-white border-[3px] border-black shadow-[6px_6px_0_#B3202A] sm:shadow-[10px_10px_0_#B3202A] p-5 sm:p-10 lg:p-16 relative overflow-hidden">
      
      <!-- Top Brutalist Deco Tag -->
      <div class="flex items-center justify-between border-b border-neutral-700 pb-4 sm:pb-6 mb-6 sm:mb-8">
        <div class="font-['JetBrains_Mono'] text-[11px] sm:text-xs font-bold text-[#FFD23F] uppercase tracking-widest flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-[#FFD23F] inline-block animate-pulse"></span>
          KOLABORASI & KONTRAK SISTEM
        </div>
        <div class="font-['JetBrains_Mono'] text-[10px] sm:text-xs text-neutral-400">
          RESPONS: CEPAT & FORMAL
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        
        <!-- Left Column: Big Pitch (7 cols) -->
        <div class="lg:col-span-7 space-y-4 sm:space-y-6">
          <h2 class="font-['Archivo_Black'] text-2xl sm:text-4xl md:text-5xl text-white leading-[1.12] uppercase break-words">
            Punya proyek desa, sekolah, atau UMKM yang butuh <span class="text-[#FFD23F] underline decoration-4 decoration-[#B3202A]">sistem nyata?</span>
          </h2>
          <p class="font-['Space_Grotesk'] text-sm sm:text-base md:text-lg text-neutral-300 max-w-xl leading-relaxed">
            Tidak perlu khawatir jika tim Anda belum paham teknis. Saya membangun solusinya sekaligus melatih tim Anda sampai bisa mengoperasikannya sendiri.
          </p>

          <!-- Real quote nod from original portfolio -->
          <div class="border-l-4 border-[#FFD23F] pl-3 sm:pl-4 py-1 text-xs sm:text-sm font-['Space_Grotesk'] text-neutral-400 italic">
            "Let's collaborate and cook something great together."
          </div>
        </div>

        <!-- Right Column: Direct Contact Channels (5 cols) -->
        <div class="lg:col-span-5 space-y-3 sm:space-y-4">
          
          <!-- WhatsApp Primary Button -->
          <a
            href={personal.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 sm:p-4 bg-[#FFD23F] text-black border-[3px] border-white shadow-[3px_3px_0_#FFF] sm:shadow-[4px_4px_0_#FFF] hover:bg-white hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0_#FFF] transition-all group focus:outline-none focus:ring-4 focus:ring-[#3A5BFF]"
          >
            <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
              <div class="w-9 h-9 sm:w-10 sm:h-10 bg-black text-[#FFD23F] border border-black flex items-center justify-center font-bold shrink-0">
                <svg class="w-5 h-5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
              </div>
              <div class="min-w-0">
                <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs font-bold text-neutral-800 uppercase block">Chat Langsung</span>
                <span class="font-['JetBrains_Mono'] text-sm sm:text-base font-black text-black truncate block uppercase">Hubungi via WhatsApp</span>
              </div>
            </div>
            <span class="font-['JetBrains_Mono'] text-lg sm:text-xl font-bold group-hover:translate-x-1 transition-transform ml-2 shrink-0">→</span>
          </a>

          <!-- Email Channel -->
          <a
            href={`mailto:${personal.email}?subject=Diskusi%20Proyek%20Sistem`}
            class="flex items-center justify-between p-3.5 sm:p-4 bg-[#1A1A1A] text-white border-[2px] border-neutral-600 hover:border-white hover:bg-neutral-900 transition-all group focus:outline-none focus:ring-2 focus:ring-[#3A5BFF]"
          >
            <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
              <div class="w-9 h-9 sm:w-10 sm:h-10 bg-neutral-800 text-white border border-neutral-700 flex items-center justify-center font-bold shrink-0">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="min-w-0">
                <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs text-neutral-400 uppercase block">Kirim Email Resmi</span>
                <span class="font-['JetBrains_Mono'] text-xs sm:text-base font-bold text-white truncate block">{personal.email}</span>
              </div>
            </div>
            <span class="font-['JetBrains_Mono'] text-base sm:text-xl font-bold text-neutral-400 group-hover:text-white group-hover:translate-x-1 transition-all ml-2 shrink-0">↗</span>
          </a>

          <!-- LinkedIn Channel -->
          <a
            href={personal.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 sm:p-4 bg-[#1A1A1A] text-white border-[2px] border-neutral-600 hover:border-white hover:bg-neutral-900 transition-all group focus:outline-none focus:ring-2 focus:ring-[#3A5BFF]"
          >
            <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
              <div class="w-9 h-9 sm:w-10 sm:h-10 bg-[#3A5BFF] text-white border border-black flex items-center justify-center font-bold shrink-0">
                in
              </div>
              <div class="min-w-0">
                <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs text-neutral-400 uppercase block">Profil LinkedIn</span>
                <span class="font-['JetBrains_Mono'] text-xs sm:text-sm font-bold text-white truncate block">{personal.linkedinDisplay}</span>
              </div>
            </div>
            <span class="font-['JetBrains_Mono'] text-base sm:text-xl font-bold text-neutral-400 group-hover:text-white group-hover:translate-x-1 transition-all ml-2 shrink-0">↗</span>
          </a>

        </div>

      </div>

      <!-- Quick Location Footer -->
      <div class="mt-8 pt-5 border-t border-neutral-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px] sm:text-xs font-['JetBrains_Mono'] text-neutral-400">
        <div>
          Domisili: <span class="text-white font-bold">{personal.location}</span>
        </div>
        <div>
          Mahasiswa S1 Sistem Informasi • Telkom University
        </div>
      </div>

    </div>

  </div>
</section>
