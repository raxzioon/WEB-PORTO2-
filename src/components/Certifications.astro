---
import { siteContent } from '../data/content';
const verifiedCertsCount = siteContent.certifications.filter((c) => c.image).length;
---

<section id="sertifikasi" class="border-b-[3px] border-black bg-[#F4F0E6] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="scroll-reveal flex flex-col md:flex-row md:items-end justify-between gap-6 border-b-[3px] border-black pb-8">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FFD23F] text-black font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider border-[2px] border-black shadow-[2px_2px_0_#000]">
          VALIDASI KOMPETENSI
        </div>
        <h2 class="font-['Archivo_Black'] text-3xl sm:text-4xl md:text-5xl text-black uppercase tracking-tight">
          Sertifikasi Industri
        </h2>
        <p class="font-['Space_Grotesk'] text-base sm:text-lg text-neutral-800 max-w-2xl">
          Sertifikasi resmi dari Google, DQLab, Dicoding, IDX, dan Ruangguru yang memvalidasi kemampuan teknis dan edukasi dengan berkas kredensial terverifikasi.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <div class="font-['JetBrains_Mono'] text-xs bg-white border-[2px] border-black p-3 font-bold uppercase shadow-[3px_3px_0_#000]">
          TOTAL: {siteContent.certifications.length} SERTIFIKAT
        </div>
        <div class="font-['JetBrains_Mono'] text-xs bg-[#7BE0B3] border-[2px] border-black p-3 font-black uppercase shadow-[3px_3px_0_#000]">
          ✓ {verifiedCertsCount} BERKAS FISIK TERVERIFIKASI
        </div>
      </div>
    </div>

    <!-- Certificate Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {siteContent.certifications.map((cert, cIdx) => (
        <div class={`scroll-reveal stagger-${(cIdx % 3) + 1} bg-white border-[3px] border-black p-5 sm:p-6 shadow-[5px_5px_0_#000] flex flex-col justify-between space-y-5 hover:-translate-y-1 transition-transform`}>
          
          <div class="space-y-4">
            <!-- Issuer & Date Meta -->
            <div class="flex items-center justify-between border-b-[2px] border-black pb-2 text-xs font-['JetBrains_Mono']">
              <span class="font-bold text-[#B3202A] uppercase">
                {cert.issuer}
              </span>
              <span class="font-bold text-neutral-600">
                {cert.date}
              </span>
            </div>

            <!-- Certificate Visual Proof (Image Thumbnail / Pending Box) -->
            {cert.image ? (
              <div 
                class="group relative border-[2px] border-black bg-neutral-100 overflow-hidden shadow-[3px_3px_0_#000] cursor-pointer"
                data-cert-trigger
                data-cert-title={cert.title}
                data-cert-issuer={cert.issuer}
                data-cert-date={cert.date}
                data-cert-id={cert.credentialId || ''}
                data-cert-image={cert.image}
                data-cert-url={cert.verifyUrl || ''}
                role="button"
                tabindex="0"
                aria-label={`Lihat sertifikat asli ${cert.title}`}
              >
                <div class="aspect-[16/11] bg-white flex items-center justify-center p-2 overflow-hidden">
                  <img 
                    src={cert.image} 
                    alt={`Sertifikat ${cert.title} - ${cert.issuer}`} 
                    class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-200"
                    loading="lazy"
                  />
                </div>

                <!-- Verified Pill -->
                <div class="absolute top-2 left-2 pointer-events-none">
                  <span class="px-2 py-0.5 bg-[#7BE0B3] text-black font-['JetBrains_Mono'] text-[10px] font-black uppercase tracking-wider border border-black shadow-[1px_1px_0_#000]">
                    ✓ BERKAS ASLI
                  </span>
                </div>

                <!-- Hover Overlay -->
                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-3 text-center">
                  <span class="px-3 py-1.5 bg-[#FFD23F] text-black font-['JetBrains_Mono'] text-xs font-black uppercase tracking-wider border-[2px] border-black shadow-[2px_2px_0_#000]">
                    🔍 KLIK PERBESAR DOKUMEN
                  </span>
                </div>
              </div>
            ) : (
              <div class="border-[2px] border-dashed border-black/40 bg-[#F4F0E6]/80 p-5 text-center space-y-1.5">
                <span class="inline-block px-2.5 py-0.5 bg-white text-neutral-700 font-['JetBrains_Mono'] text-[10px] font-bold uppercase border border-black/30">
                  📄 ARSIP DIGITAL MENYUSUL
                </span>
                <p class="font-['Space_Grotesk'] text-xs text-neutral-600 leading-snug">
                  Dokumen fisik sedang dalam antrean pemindaian & verifikasi.
                </p>
              </div>
            )}

            <!-- Title & ID -->
            <div class="space-y-2">
              <h3 class="font-['Archivo_Black'] text-lg sm:text-xl text-black leading-snug">
                {cert.title}
              </h3>

              <!-- Category & ID -->
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-['JetBrains_Mono'] text-[11px] font-bold px-2 py-0.5 bg-[#FFD23F] border border-black text-black">
                  {cert.category}
                </span>
                {cert.credentialId && (
                  <span class="font-['JetBrains_Mono'] text-[11px] font-bold px-2 py-0.5 bg-neutral-100 border border-black text-neutral-800">
                    ID: {cert.credentialId}
                  </span>
                )}
              </div>
            </div>
          </div>

          <!-- Footer Actions & Competency Note -->
          <div class="pt-3 border-t-[2px] border-black/10 space-y-3">
            <div class="font-['Space_Grotesk'] text-xs text-neutral-600 leading-relaxed">
              {cert.verifyNote}
            </div>

            <!-- Action Buttons for Verified Docs -->
            {cert.image && (
              <button 
                type="button"
                class="w-full text-center py-2 px-3 bg-[#FFD23F] hover:bg-black hover:text-[#FFD23F] text-black font-['JetBrains_Mono'] text-xs font-black uppercase border-[2px] border-black shadow-[3px_3px_0_#000] hover:shadow-[1px_1px_0_#000] hover:translate-x-0.5 hover:translate-y-0.5 transition-all flex items-center justify-center gap-2"
                data-cert-trigger
                data-cert-title={cert.title}
                data-cert-issuer={cert.issuer}
                data-cert-date={cert.date}
                data-cert-id={cert.credentialId || ''}
                data-cert-image={cert.image}
                data-cert-url={cert.verifyUrl || ''}
              >
                <span>Lihat Sertifikat Fisik</span>
                <span>→</span>
              </button>
            )}

            {cert.verifyUrl && (
              <a 
                href={cert.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full text-center py-2 px-3 bg-white hover:bg-black hover:text-white text-black font-['JetBrains_Mono'] text-xs font-bold uppercase border-[2px] border-black shadow-[2px_2px_0_#000] hover:shadow-[1px_1px_0_#000] hover:translate-x-0.5 hover:translate-y-0.5 transition-all flex items-center justify-center gap-1.5"
              >
                <span>Verifikasi Web Resmi</span>
                <span>↗</span>
              </a>
            )}
          </div>

        </div>
      ))}
    </div>

  </div>

  <!-- ========================================================================= -->
  <!-- NEO-BRUTALIST CERTIFICATE LIGHTBOX MODAL -->
  <!-- ========================================================================= -->
  <div 
    id="cert-lightbox-modal" 
    class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 bg-black/85 backdrop-blur-sm" 
    role="dialog" 
    aria-modal="true" 
    aria-labelledby="modal-cert-title"
  >
    <div class="relative w-full max-w-4xl max-h-[94vh] bg-[#F4F0E6] border-[4px] border-black shadow-[10px_10px_0_#000] flex flex-col overflow-hidden">
      
      <!-- Modal Top Bar -->
      <div class="bg-[#FFD23F] border-b-[3px] border-black px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 min-w-0">
          <span class="px-2 py-0.5 bg-black text-white font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider shrink-0">
            BERKAS ASLI
          </span>
          <span id="modal-cert-issuer" class="font-['JetBrains_Mono'] text-xs font-black text-black uppercase truncate"></span>
        </div>
        <button 
          id="modal-cert-close" 
          type="button" 
          class="px-3 py-1 bg-white hover:bg-[#B3202A] hover:text-white text-black font-['JetBrains_Mono'] text-xs font-black uppercase border-[2px] border-black shadow-[2px_2px_0_#000] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all shrink-0 cursor-pointer"
          aria-label="Tutup jendela sertifikat"
        >
          [ ✕ TUTUP (ESC) ]
        </button>
      </div>

      <!-- Modal Content: Scrollable Body -->
      <div class="p-4 sm:p-6 overflow-y-auto space-y-4">
        <div class="space-y-1">
          <h3 id="modal-cert-title" class="font-['Archivo_Black'] text-xl sm:text-2xl text-black"></h3>
          <div class="flex flex-wrap items-center gap-2 sm:gap-4 font-['JetBrains_Mono'] text-xs text-neutral-700">
            <span id="modal-cert-date"></span>
            <span id="modal-cert-id" class="hidden font-bold px-2 py-0.5 bg-white border border-black text-black"></span>
          </div>
        </div>

        <!-- High-res Image Preview Frame -->
        <div class="border-[3px] border-black bg-white p-3 shadow-[4px_4px_0_#000] flex items-center justify-center min-h-[240px] sm:min-h-[440px]">
          <img 
            id="modal-cert-img" 
            src="" 
            alt="Pratinjau Dokumen Sertifikat Asli" 
            class="max-h-[62vh] w-auto max-w-full object-contain mx-auto" 
          />
        </div>
      </div>

      <!-- Modal Footer Actions -->
      <div class="bg-white border-t-[3px] border-black px-4 sm:px-6 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="font-['JetBrains_Mono'] text-xs text-neutral-600">
          Penerima Kredensial: <strong class="text-black">Muhammad Adzka Arroya</strong>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
          <a 
            id="modal-cert-external-link" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hidden px-3 py-1.5 bg-[#3A5BFF] hover:bg-black text-white font-['JetBrains_Mono'] text-xs font-bold uppercase border-[2px] border-black shadow-[2px_2px_0_#000] active:translate-x-0.5 active:translate-y-0.5 transition-all"
          >
            Verifikasi Web Resmi ↗
          </a>
          <a 
            id="modal-cert-raw-img-link" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3 py-1.5 bg-[#FFD23F] hover:bg-black hover:text-[#FFD23F] text-black font-['JetBrains_Mono'] text-xs font-bold uppercase border-[2px] border-black shadow-[2px_2px_0_#000] active:translate-x-0.5 active:translate-y-0.5 transition-all"
          >
            Buka Dokumen Resolusi Penuh ↗
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function setupCertLightbox() {
    const modal = document.getElementById('cert-lightbox-modal');
    if (!modal) return;

    const closeBtn = document.getElementById('modal-cert-close');
    const modalTitle = document.getElementById('modal-cert-title');
    const modalIssuer = document.getElementById('modal-cert-issuer');
    const modalDate = document.getElementById('modal-cert-date');
    const modalId = document.getElementById('modal-cert-id');
    const modalImg = document.getElementById('modal-cert-img') as HTMLImageElement | null;
    const modalRawLink = document.getElementById('modal-cert-raw-img-link') as HTMLAnchorElement | null;
    const modalExtLink = document.getElementById('modal-cert-external-link') as HTMLAnchorElement | null;

    function openModal(data: {
      title: string;
      issuer: string;
      date: string;
      id: string;
      img: string;
      url: string;
    }) {
      if (modalTitle) modalTitle.textContent = data.title;
      if (modalIssuer) modalIssuer.textContent = data.issuer;
      if (modalDate) modalDate.textContent = `Tanggal Terbit: ${data.date}`;
      
      if (modalId) {
        if (data.id) {
          modalId.textContent = `ID: ${data.id}`;
          modalId.classList.remove('hidden');
        } else {
          modalId.classList.add('hidden');
        }
      }

      if (modalImg) {
        modalImg.src = data.img;
        modalImg.alt = `Sertifikat ${data.title} - ${data.issuer}`;
      }

      if (modalRawLink) {
        modalRawLink.href = data.img;
      }

      if (modalExtLink) {
        if (data.url) {
          modalExtLink.href = data.url;
          modalExtLink.classList.remove('hidden');
        } else {
          modalExtLink.classList.add('hidden');
        }
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
      if (modalImg) modalImg.src = '';
    }

    // Attach to triggers (cards & buttons)
    document.querySelectorAll('[data-cert-trigger]').forEach((el) => {
      // Avoid attaching duplicate event listeners
      if ((el as any)._hasCertListener) return;
      (el as any)._hasCertListener = true;

      el.addEventListener('click', (e) => {
        e.preventDefault();
        const target = el as HTMLElement;
        openModal({
          title: target.dataset.certTitle || '',
          issuer: target.dataset.certIssuer || '',
          date: target.dataset.certDate || '',
          id: target.dataset.certId || '',
          img: target.dataset.certImage || '',
          url: target.dataset.certUrl || '',
        });
      });

      // Keyboard accessibility (Enter / Space) for card containers
      el.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          (el as HTMLElement).click();
        }
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    // Click backdrop to close
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // ESC key to close
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  // Initialize on load and on client-side navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCertLightbox);
  } else {
    setupCertLightbox();
  }
  document.addEventListener('astro:page-load', setupCertLightbox);
</script>
