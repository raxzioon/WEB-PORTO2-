---
import { siteContent } from '../data/content';
---

<section class="border-b-[3px] border-black bg-white" aria-label="Ringkasan Bukti Nyata">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y-[3px] sm:divide-y-0 sm:divide-x-[3px] divide-black">
      {siteContent.proofMetrics.map((metric, idx) => (
        <div class="p-6 sm:p-8 flex flex-col justify-between hover:bg-[#F4F0E6] transition-colors group">
          <div>
            <span class="font-['JetBrains_Mono'] text-xs font-bold text-[#B3202A] uppercase tracking-wider block mb-1">
              [BUKTI #{String(idx + 1).padStart(2, '0')}]
            </span>
            <div class="font-['JetBrains_Mono'] text-4xl sm:text-5xl font-black text-black tracking-tight group-hover:translate-x-1 transition-transform">
              {metric.value}
            </div>
            <div class="font-['Space_Grotesk'] text-lg font-bold text-black mt-2">
              {metric.label}
            </div>
          </div>
          <p class="font-['Space_Grotesk'] text-xs sm:text-sm text-neutral-600 mt-3 pt-3 border-t-2 border-black/10">
            {metric.detail}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
