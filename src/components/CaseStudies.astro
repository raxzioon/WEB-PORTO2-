---
import { siteContent } from '../data/content';
const [desa, telugig] = siteContent.caseStudies;
---

<section id="studi-kasus" class="border-b-[3px] border-black bg-[#F4F0E6] py-14 md:py-20 lg:py-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 md:space-y-16">
    
    <!-- Section Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#3A5BFF] text-white font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider border-[2px] border-black shadow-[2px_2px_0_#000]">
        STUDI KASUS & BUKTI NYATA
      </div>
      <h2 class="font-['Archivo_Black'] text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-black uppercase tracking-tight">
        Sistem Nyata. Bukan Sekadar Tugas Kuliah.
      </h2>
      <p class="font-['Space_Grotesk'] text-sm sm:text-base md:text-lg text-neutral-800 max-w-3xl">
        Dua proyek pembuktian: satu sistem operasional instansi desa yang langsung melayani ribuan warga, dan satu perancangan platform bisnis freelance teruji yang meraih juara 1 di kompetisi universitas.
      </p>
    </div>

    <!-- ========================================================================= -->
    <!-- CASE STUDY 1: PLATFORM DIGITAL DESA DENANYAR -->
    <!-- ========================================================================= -->
    <article class="bg-white border-[3px] border-black shadow-[6px_6px_0_#000] sm:shadow-[8px_8px_0_#000] overflow-hidden">
      
      <!-- Top Title Bar: Responsive Wrap -->
      <div class="bg-[#FFD23F] border-b-[3px] border-black px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-0.5 bg-black text-white font-['JetBrains_Mono'] text-[10px] sm:text-xs font-bold uppercase tracking-wider">
            {desa.badge}
          </span>
          <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs font-bold text-black uppercase">
            {desa.period}
          </span>
        </div>
        <div class="font-['JetBrains_Mono'] text-[10px] sm:text-xs font-black uppercase text-black bg-white px-2.5 py-1 border-[2px] border-black shadow-[2px_2px_0_#000] self-start sm:self-auto">
          Peran: {desa.role}
        </div>
      </div>

      <div class="p-4 sm:p-6 lg:p-8 space-y-8">
        
        <!-- Header Info -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          <div class="lg:col-span-8 space-y-2">
            <h3 class="font-['Archivo_Black'] text-xl sm:text-2xl md:text-3xl lg:text-4xl text-black leading-snug">
              {desa.title}
            </h3>
            <p class="font-['Space_Grotesk'] text-sm sm:text-base md:text-lg font-medium text-neutral-800">
              {desa.subtitle}
            </p>
          </div>
          <div class="lg:col-span-4 bg-[#F4F0E6] border-[2px] border-black p-3.5 space-y-2">
            <div class="font-['JetBrains_Mono'] text-[11px] font-bold text-neutral-600 uppercase">Klien & Wilayah:</div>
            <div class="font-['Space_Grotesk'] text-xs sm:text-sm font-bold text-black flex items-center gap-2">
              <img src={desa.visualAssets.sragenLogo} alt="Logo Kab. Sragen" class="w-6 h-6 object-contain shrink-0" />
              <span>{desa.client}</span>
            </div>
            <div class="font-['JetBrains_Mono'] text-[11px] text-neutral-700 pt-1 border-t border-black/20">
              Cakupan Pengguna: <span class="font-bold text-black">{desa.targetAudience}</span>
            </div>
          </div>
        </div>

        <!-- Problem vs Solution Breakdown -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6">
          
          <!-- Problem Box -->
          <div class="border-[3px] border-black bg-[#FFF7F7] p-5 space-y-3">
            <div class="inline-block px-2.5 py-0.5 bg-[#B3202A] text-white font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider">
              TANTANGAN / MASALAH AWAL
            </div>
            <p class="font-['Space_Grotesk'] text-xs sm:text-sm md:text-base text-neutral-800 leading-relaxed">
              {desa.problem}
            </p>
            <div class="pt-1 font-['JetBrains_Mono'] text-xs text-[#B3202A] font-semibold">
              Bottleneck: Warga harus izin kerja hanya untuk antre berkas fisik surat di balai desa.
            </div>
          </div>

          <!-- Adzka's Solution Box -->
          <div class="border-[3px] border-black bg-[#F8FFF9] p-5 space-y-3">
            <div class="inline-block px-2.5 py-0.5 bg-black text-[#FFD23F] font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider">
              YANG SAYA BANGUN (SOLUSI)
            </div>
            <ul class="space-y-2 font-['Space_Grotesk'] text-xs sm:text-sm md:text-base text-neutral-800">
              {desa.whatAdzkaBuilt.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="inline-block w-1.5 h-1.5 bg-black mt-2 shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

        <!-- Tech Stack Badges -->
        <div class="border-t-[2px] border-black pt-5">
          <span class="font-['JetBrains_Mono'] text-xs font-bold uppercase text-neutral-600 block mb-2.5">
            TECH STACK & INFRASTRUKTUR YANG DIGUNAKAN:
          </span>
          <div class="flex flex-wrap gap-2">
            {desa.techStack.map((tech) => (
              <span class="font-['JetBrains_Mono'] text-xs sm:text-sm font-bold px-3 py-1 bg-white border-[2px] border-black shadow-[2px_2px_0_#000] text-black hover:bg-[#FFD23F] transition-colors">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Visual Architecture & Features Showcase -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider text-black">
              ARSITEKTUR & FITUR KUNCI SISTEM DENANYAR:
            </span>
            <span class="font-['JetBrains_Mono'] text-[11px] text-neutral-600 hidden sm:inline">
              Sragen, Jawa Tengah
            </span>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
            
            <!-- Desktop Portal Mockup (7 cols) -->
            <div class="lg:col-span-7 border-[3px] border-black bg-black p-2 shadow-[4px_4px_0_#000] flex flex-col justify-between">
              <div>
                <div class="bg-[#0A0A0A] text-white px-3 py-1.5 font-['JetBrains_Mono'] text-[10px] sm:text-[11px] flex items-center justify-between border-b border-white/20 gap-2">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#B3202A] inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#FFD23F] inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#7BE0B3] inline-block"></span>
                    <span class="ml-2 font-bold text-neutral-300">denanyar-tangen.desa.id</span>
                  </div>
                  <a
                    href="https://denanyar-tangen.desa.id/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 px-2 py-0.5 bg-[#FFD23F] text-black font-black text-[10px] uppercase hover:bg-white transition-colors"
                  >
                    <span>Situs Aktif ↗</span>
                  </a>
                </div>
                <a
                  href="https://denanyar-tangen.desa.id/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block relative bg-neutral-900 border border-white/20 mt-1.5 group cursor-pointer"
                  title="Buka Website Resmi Desa Denanyar di tab baru"
                >
                  <img
                    src={desa.visualAssets.hero}
                    alt="Tampilan antarmuka website resmi Desa Denanyar karya Muhammad Adzka Arroya"
                    class="w-full h-auto object-cover group-hover:opacity-95 transition-opacity"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                    <span class="bg-[#FFD23F] text-black font-['JetBrains_Mono'] text-xs font-bold px-3 py-1.5 border-[2px] border-black shadow-[3px_3px_0_#000]">
                      Klik untuk Buka Website Asli ↗
                    </span>
                  </div>
                </a>
              </div>
              <div class="pt-2 px-1 flex flex-col sm:flex-row sm:items-center justify-between gap-1 font-['JetBrains_Mono'] text-[11px] text-white/90">
                <span>Layanan Publik Digital: Surat Mandiri Warga, Profil Desa, & Informasi Kependudukan.</span>
                <a
                  href="https://denanyar-tangen.desa.id/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#FFD23F] hover:underline font-bold shrink-0"
                >
                  Buka denanyar-tangen.desa.id ↗
                </a>
              </div>
            </div>

            <!-- 3 Key System Modules Feature Cards (5 cols) -->
            <div class="lg:col-span-5 grid grid-cols-1 gap-3">
              
              <div class="border-[2px] border-black bg-[#F4F0E6] p-3.5 space-y-1 shadow-[3px_3px_0_#000]">
                <div class="flex items-center justify-between font-['JetBrains_Mono'] text-xs font-bold">
                  <span class="text-[#B3202A] uppercase">Modul 01: Surat Online</span>
                  <span class="bg-white px-1.5 py-0.5 border border-black text-[10px]">Warga Mandiri</span>
                </div>
                <p class="font-['Space_Grotesk'] text-xs text-neutral-800">
                  Warga mengisi formulir surat (Domisili, Usaha, SKTM) lewat HP tanpa perlu antre fisik di balai desa.
                </p>
              </div>

              <div class="border-[2px] border-black bg-white p-3.5 space-y-1 shadow-[3px_3px_0_#000]">
                <div class="flex items-center justify-between font-['JetBrains_Mono'] text-xs font-bold">
                  <span class="text-[#3A5BFF] uppercase">Modul 02: Dashboard Demografi</span>
                  <span class="bg-[#FFD23F] px-1.5 py-0.5 border border-black text-[10px]">Real-Time Data</span>
                </div>
                <p class="font-['Space_Grotesk'] text-xs text-neutral-800">
                  Visualisasi data 4.458 penduduk, 1.503 KK, dan 19 RT untuk kebutuhan pelaporan cepat aparatur desa.
                </p>
              </div>

              <div class="border-[2px] border-black bg-[#F4F0E6] p-3.5 space-y-1 shadow-[3px_3px_0_#000]">
                <div class="flex items-center justify-between font-['JetBrains_Mono'] text-xs font-bold">
                  <span class="text-black uppercase">Modul 03: Docker & Admin Super</span>
                  <span class="bg-white px-1.5 py-0.5 border border-black text-[10px]">Containerized</span>
                </div>
                <p class="font-['Space_Grotesk'] text-xs text-neutral-800">
                  Pengelolaan hak akses staf desa, publikasi warta komunitas, dan environment Docker Sail yang reliabel.
                </p>
              </div>

            </div>

          </div>
        </div>

        <!-- Real Results Strip -->
        <div class="bg-[#F4F0E6] border-[3px] border-black p-5 space-y-3">
          <div class="font-['JetBrains_Mono'] text-xs font-bold text-black uppercase tracking-wider flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#B3202A] inline-block"></span>
            HASIL & IMPACT NYATA:
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            {desa.results.map((res, rIdx) => (
              <div class="bg-white border-[2px] border-black p-3 shadow-[2px_2px_0_#000]">
                <div class="font-['JetBrains_Mono'] text-xs font-black text-[#B3202A] mb-1">
                  [0{rIdx + 1}]
                </div>
                <p class="font-['Space_Grotesk'] text-xs font-semibold text-black">
                  {res}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Live Website Call to Action Bar -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 sm:p-5 bg-[#7BE0B3] border-[3px] border-black shadow-[4px_4px_0_#000]">
          <div class="space-y-1 text-center sm:text-left">
            <div class="font-['Archivo_Black'] text-sm sm:text-base md:text-lg text-black uppercase">
              Website Ini Sudah Aktif & Berjalan di Lingkungan Produksi
            </div>
            <div class="font-['Space_Grotesk'] text-xs sm:text-sm text-black font-medium flex flex-wrap items-center justify-center sm:justify-start gap-1">
              <span>Domain resmi terverifikasi:</span>
              <code class="font-['JetBrains_Mono'] font-bold text-[11px] sm:text-xs bg-white px-1.5 py-0.5 border border-black text-black">denanyar-tangen.desa.id</code>
            </div>
          </div>
          <a
            href="https://denanyar-tangen.desa.id/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-black text-white font-['JetBrains_Mono'] text-xs sm:text-sm font-bold uppercase tracking-wider border-[2px] border-black shadow-[3px_3px_0_#fff] hover:bg-[#B3202A] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[1px_1px_0_#fff] transition-all"
          >
            <span>Kunjungi Website Resmi</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

      </div>
    </article>

    <!-- ========================================================================= -->
    <!-- CASE STUDY 2: TELUGIG - FREELANCE KAMPUS X UMKM -->
    <!-- ========================================================================= -->
    <article class="bg-white border-[3px] border-black shadow-[6px_6px_0_#000] sm:shadow-[8px_8px_0_#000] overflow-hidden">
      
      <!-- Top Title Bar -->
      <div class="bg-[#B3202A] text-white border-b-[3px] border-black px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-0.5 bg-[#FFD23F] text-black font-['JetBrains_Mono'] text-[10px] sm:text-xs font-black uppercase tracking-wider">
            {telugig.badge}
          </span>
          <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs font-bold text-white uppercase">
            {telugig.period}
          </span>
        </div>
        <div class="font-['JetBrains_Mono'] text-[10px] sm:text-xs font-bold uppercase text-white bg-black px-2.5 py-1 border-[2px] border-white shadow-[2px_2px_0_#000] self-start sm:self-auto">
          Peran: {telugig.role}
        </div>
      </div>

      <div class="p-4 sm:p-6 lg:p-8 space-y-8">
        
        <!-- Header Info -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          <div class="lg:col-span-8 space-y-2">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-[#FFD23F] border-[2px] border-black font-['JetBrains_Mono'] text-[10px] sm:text-xs font-black text-black">
              🏆 JUARA 1 BIZCREATE 2026 BUSINESS PLAN COMPETITION
            </div>
            <h3 class="font-['Archivo_Black'] text-xl sm:text-2xl md:text-3xl lg:text-4xl text-black leading-snug">
              {telugig.title}
            </h3>
            <p class="font-['Space_Grotesk'] text-sm sm:text-base md:text-lg font-medium text-neutral-800">
              {telugig.subtitle}
            </p>
          </div>
          <div class="lg:col-span-4 bg-[#F4F0E6] border-[2px] border-black p-3.5 space-y-2">
            <div class="font-['JetBrains_Mono'] text-[11px] font-bold text-neutral-600 uppercase">Validasi Pasar:</div>
            <div class="font-['Space_Grotesk'] text-xs sm:text-sm font-bold text-black">
              {telugig.client}
            </div>
            <div class="font-['JetBrains_Mono'] text-[11px] text-neutral-700 pt-1 border-t border-black/20">
              Penyelenggara: <span class="font-bold text-[#B3202A]">BEM KEMA FKS Telkom University</span>
            </div>
          </div>
        </div>

        <!-- Problem vs Solution Breakdown -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6">
          
          <!-- Problem Box -->
          <div class="border-[3px] border-black bg-[#FFF7F7] p-5 space-y-3">
            <div class="inline-block px-2.5 py-0.5 bg-[#B3202A] text-white font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider">
              PROBLEMATIKA PASAR
            </div>
            <p class="font-['Space_Grotesk'] text-xs sm:text-sm md:text-base text-neutral-800 leading-relaxed">
              {telugig.problem}
            </p>
            <div class="pt-1 font-['JetBrains_Mono'] text-xs text-[#B3202A] font-semibold">
              Kesenjangan: Mahasiswa butuh jam terbang riil; UMKM butuh harga wajar tanpa risiko uang dibawa kabur.
            </div>
          </div>

          <!-- What Was Designed & Built -->
          <div class="border-[3px] border-black bg-[#F8FFF9] p-5 space-y-3">
            <div class="inline-block px-2.5 py-0.5 bg-black text-[#FFD23F] font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider">
              ARSITEKTUR & MODEL SOLUSI
            </div>
            <ul class="space-y-2 font-['Space_Grotesk'] text-xs sm:text-sm md:text-base text-neutral-800">
              {telugig.whatAdzkaBuilt.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="inline-block w-1.5 h-1.5 bg-black mt-2 shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

        <!-- Key Business Model Pillars -->
        <div class="border-[3px] border-black bg-white p-5 space-y-4 shadow-[4px_4px_0_#000]">
          <span class="font-['JetBrains_Mono'] text-xs font-bold uppercase text-neutral-600 tracking-wider block">
            4 PILAR UTAMA EKONOMI TELUGIG (MENGAPA MEMENANGKAN KOMPETISI):
          </span>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
            
            <div class="border-[2px] border-black p-3.5 bg-[#FFD23F]/30 space-y-1">
              <span class="font-['JetBrains_Mono'] text-xs font-black text-[#B3202A] uppercase block">
                01. ZERO-FEE
              </span>
              <div class="font-['Space_Grotesk'] text-sm sm:text-base font-bold text-black">
                {telugig.businessModel?.studentFee}
              </div>
              <p class="font-['Space_Grotesk'] text-xs text-neutral-700">
                Mahasiswa tidak dipotong sepeser pun dari upah jasanya demi memacu portofolio.
              </p>
            </div>

            <div class="border-[2px] border-black p-3.5 bg-[#3A5BFF]/10 space-y-1">
              <span class="font-['JetBrains_Mono'] text-xs font-black text-[#3A5BFF] uppercase block">
                02. CLIENT REVENUE
              </span>
              <div class="font-['Space_Grotesk'] text-sm sm:text-base font-bold text-black">
                {telugig.businessModel?.clientFee}
              </div>
              <p class="font-['Space_Grotesk'] text-xs text-neutral-700">
                UMKM membayar biaya keberhasilan sebagai garansi kurasi talenta dan kepastian deliverable.
              </p>
            </div>

            <div class="border-[2px] border-black p-3.5 bg-[#B3202A]/10 space-y-1">
              <span class="font-['JetBrains_Mono'] text-xs font-black text-[#B3202A] uppercase block">
                03. REKBER / ESCROW
              </span>
              <div class="font-['Space_Grotesk'] text-sm sm:text-base font-bold text-black">
                {telugig.businessModel?.security}
              </div>
              <p class="font-['Space_Grotesk'] text-xs text-neutral-700">
                DP wajib dititipkan di sistem sampai UMKM menyetujui hasil kerja final.
              </p>
            </div>

            <div class="border-[2px] border-black p-3.5 bg-white space-y-1">
              <span class="font-['JetBrains_Mono'] text-xs font-black text-black uppercase block">
                04. HIPER-LOKAL
              </span>
              <div class="font-['Space_Grotesk'] text-sm sm:text-base font-bold text-black">
                Validasi Bandung Raya
              </div>
              <p class="font-['Space_Grotesk'] text-xs text-neutral-700">
                Fokus ekosistem kampus Telkom University dan UMKM sekitar Bojongsoang.
              </p>
            </div>

          </div>
        </div>

        <!-- Results & Accolades -->
        <div class="bg-[#F4F0E6] border-[3px] border-black p-5 space-y-3">
          <div class="font-['JetBrains_Mono'] text-xs font-bold text-black uppercase tracking-wider flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#B3202A] inline-block"></span>
            HASIL & PENGAKUAN RESMI:
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            {telugig.results.map((res, idx) => (
              <div class="bg-white border-[2px] border-black p-3.5 shadow-[2px_2px_0_#000]">
                <span class="font-['JetBrains_Mono'] text-xs font-bold text-[#B3202A] block mb-1">
                  PENCAPAIAN #{idx + 1}
                </span>
                <p class="font-['Space_Grotesk'] text-xs sm:text-sm font-semibold text-black">
                  {res}
                </p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </article>

  </div>
</section>
